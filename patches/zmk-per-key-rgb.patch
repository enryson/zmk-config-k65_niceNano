+static void zmk_rgb_underglow_effect_diagnostic(void) {
+    for (int i = 0; i < STRIP_NUM_PIXELS; i++) {
+        pixels[i] = (struct led_rgb){r : 0, g : 0, b : 0};
+    }
+
+    const int pixel = state.animation_step / 10;
+    pixels[pixel] = hsb_to_rgb(hsb_scale_min_max((struct zmk_led_hsb){h : 0, s : 100, b : 100}));
+
+    state.animation_step = (state.animation_step + 1) % (STRIP_NUM_PIXELS * 10);
+}
+
+#if DT_HAS_CHOSEN(zmk_rgb_key_indicators)
