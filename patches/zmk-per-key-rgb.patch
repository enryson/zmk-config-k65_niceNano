+static void zmk_rgb_underglow_effect_diagnostic(void) {
+    for (int i = 0; i < STRIP_NUM_PIXELS; i++) {
+        pixels[i] = (struct led_rgb){r : 0, g : 0, b : 0};
+    }
+
+    const int pixel = state.animation_step / 10;
+    pixels[pixel] = hsb_to_rgb(hsb_scale_min_max((struct zmk_led_hsb){h : 0, s : 100, b : 100}));
+
+    state.animation_step = (state.animation_step + 1) % (STRIP_NUM_PIXELS * 10);
+}
+
+#if DT_HAS_CHOSEN(zmk_rgb_key_indicators)
+#define KEY_INDICATORS DT_CHOSEN(zmk_rgb_key_indicators)
+
+static const uint8_t fn_leds[] = DT_PROP(KEY_INDICATORS, fn_leds);
+
+BUILD_ASSERT(DT_PROP(KEY_INDICATORS, capslock_led) < STRIP_NUM_PIXELS,
+             "Caps Lock LED index exceeds the RGB chain length");
+
+#define ASSERT_FN_LED(node_id, prop, idx)                                                         \
+    BUILD_ASSERT(DT_PROP_BY_IDX(node_id, prop, idx) < STRIP_NUM_PIXELS,                           \
+                 "Fn LED index exceeds the RGB chain length");
+DT_FOREACH_PROP_ELEM(KEY_INDICATORS, fn_leds, ASSERT_FN_LED)
+
+static struct led_rgb complementary_color(struct led_rgb color) {
+    const uint8_t low = MIN(color.r, MIN(color.g, color.b));
+    const uint8_t high = MAX(color.r, MAX(color.g, color.b));
+
+    return (struct led_rgb){
+        r : high + low - color.r,
+        g : high + low - color.g,
+        b : high + low - color.b
+    };
+}
+
+static void zmk_rgb_underglow_apply_key_indicators(void) {
+    if (state.current_effect == UNDERGLOW_EFFECT_DIAGNOSTIC) {
+        return;
+    }
+
+    bool highlighted[STRIP_NUM_PIXELS] = {};
+
+    if (zmk_hid_indicators_get_current_profile() & BIT(1)) {
+        highlighted[DT_PROP(KEY_INDICATORS, capslock_led)] = true;
+    }
+
+    if (zmk_keymap_layer_active(DT_PROP(KEY_INDICATORS, fn_layer))) {
+        for (int i = 0; i < ARRAY_SIZE(fn_leds); i++) {
+            highlighted[fn_leds[i]] = true;
+        }
+    }
+
+    for (int i = 0; i < STRIP_NUM_PIXELS; i++) {
+        if (highlighted[i]) {
+            pixels[i] = complementary_color(pixels[i]);
+        }
+    }
+}
+#else
+static void zmk_rgb_underglow_apply_key_indicators(void) {}
+#endif
