+
+static const uint8_t fn_common_leds[] = DT_PROP(KEY_INDICATORS, fn_common_leds);
+static const uint8_t fn_fkey_leds[] = DT_PROP(KEY_INDICATORS, fn_fkey_leds);
+static const uint8_t fn_bluetooth_leds[] = DT_PROP(KEY_INDICATORS, fn_bluetooth_leds);
+static const uint8_t fn_rgb_leds[] = DT_PROP(KEY_INDICATORS, fn_rgb_leds);
+static const uint8_t fn_media_leds[] = DT_PROP(KEY_INDICATORS, fn_media_leds);
+static const uint8_t fn_system_leds[] = DT_PROP(KEY_INDICATORS, fn_system_leds);
+static const uint8_t fn_editing_leds[] = DT_PROP(KEY_INDICATORS, fn_editing_leds);
+
+BUILD_ASSERT(DT_PROP(KEY_INDICATORS, capslock_led) < STRIP_NUM_PIXELS,
+             "Caps Lock LED index exceeds the RGB chain length");
+BUILD_ASSERT(DT_PROP(KEY_INDICATORS, minimum_saturation) <= SAT_MAX,
+             "RGB indicator minimum saturation exceeds 100");
+
+#define ASSERT_FN_LED(node_id, prop, idx)                                                         \
+    BUILD_ASSERT(DT_PROP_BY_IDX(node_id, prop, idx) < STRIP_NUM_PIXELS,                           \
+                 "Fn LED index exceeds the RGB chain length");
+DT_FOREACH_PROP_ELEM(KEY_INDICATORS, fn_common_leds, ASSERT_FN_LED)
+DT_FOREACH_PROP_ELEM(KEY_INDICATORS, fn_fkey_leds, ASSERT_FN_LED)
+DT_FOREACH_PROP_ELEM(KEY_INDICATORS, fn_bluetooth_leds, ASSERT_FN_LED)
+DT_FOREACH_PROP_ELEM(KEY_INDICATORS, fn_rgb_leds, ASSERT_FN_LED)
+DT_FOREACH_PROP_ELEM(KEY_INDICATORS, fn_media_leds, ASSERT_FN_LED)
+DT_FOREACH_PROP_ELEM(KEY_INDICATORS, fn_system_leds, ASSERT_FN_LED)
+DT_FOREACH_PROP_ELEM(KEY_INDICATORS, fn_editing_leds, ASSERT_FN_LED)
+
+static struct zmk_led_hsb rgb_to_hsb(struct led_rgb color) {
+    const uint8_t low = MIN(color.r, MIN(color.g, color.b));
+    const uint8_t high = MAX(color.r, MAX(color.g, color.b));
+    struct zmk_led_hsb hsb = {h : 0, s : 0, b : (high * BRT_MAX + 127) / 255};
+
+    if (high == low) {
+        return hsb;
+    }
+
+    const int delta = high - low;
+    hsb.s = (delta * SAT_MAX + high / 2) / high;
+
+    int hue;
+    if (high == color.r) {
+        hue = 60 * ((int)color.g - color.b) / delta;
+    } else if (high == color.g) {
+        hue = 120 + 60 * ((int)color.b - color.r) / delta;
+    } else {
+        hue = 240 + 60 * ((int)color.r - color.g) / delta;
+    }
+
+    hsb.h = (hue + HUE_MAX) % HUE_MAX;
+    return hsb;
+}
+
+static struct led_rgb rotate_hue(struct led_rgb color, uint16_t offset) {
+    if (color.r == 0 && color.g == 0 && color.b == 0) {
+        return color;
+    }
+
+    struct zmk_led_hsb hsb = rgb_to_hsb(color);
+    hsb.h = (hsb.h + offset) % HUE_MAX;
+    hsb.s = MAX(hsb.s, DT_PROP(KEY_INDICATORS, minimum_saturation));
+    return hsb_to_rgb(hsb);
+}
+
+static void mark_group(uint16_t *offsets, const uint8_t *leds, size_t len, uint16_t hue_offset) {
+    for (size_t i = 0; i < len; i++) {
+        offsets[leds[i]] = hue_offset;
+    }
+}
+
+static void zmk_rgb_underglow_apply_key_indicators(void) {
+    if (state.current_effect == UNDERGLOW_EFFECT_DIAGNOSTIC) {
+        return;
+    }
+
+    uint16_t hue_offsets[STRIP_NUM_PIXELS] = {};
+
+    if (zmk_hid_indicators_get_current_profile() & BIT(1)) {
+        hue_offsets[DT_PROP(KEY_INDICATORS, capslock_led)] = 180;
+    }
+
+    if (zmk_keymap_layer_active(DT_PROP(KEY_INDICATORS, fn_layer))) {
+        mark_group(hue_offsets, fn_common_leds, ARRAY_SIZE(fn_common_leds), 180);
+        mark_group(hue_offsets, fn_fkey_leds, ARRAY_SIZE(fn_fkey_leds), 165);
+        mark_group(hue_offsets, fn_bluetooth_leds, ARRAY_SIZE(fn_bluetooth_leds), 195);
+        mark_group(hue_offsets, fn_rgb_leds, ARRAY_SIZE(fn_rgb_leds), 150);
+        mark_group(hue_offsets, fn_media_leds, ARRAY_SIZE(fn_media_leds), 210);
+        mark_group(hue_offsets, fn_system_leds, ARRAY_SIZE(fn_system_leds), 135);
+        mark_group(hue_offsets, fn_editing_leds, ARRAY_SIZE(fn_editing_leds), 225);
+    }
+
+    for (int i = 0; i < STRIP_NUM_PIXELS; i++) {
+        if (hue_offsets[i] != 0) {
+            pixels[i] = rotate_hue(pixels[i], hue_offsets[i]);
+        }
+    }
+}
+#else
+static void zmk_rgb_underglow_apply_key_indicators(void) {}
+#endif
